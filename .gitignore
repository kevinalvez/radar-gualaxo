# Temp
temp/

# Selenium/Chrome profile for wppsender/send_clipping.py - contains a
# real, authenticated WhatsApp Web session (cookies, IndexedDB, etc.).
# Never commit this - it's equivalent to committing a login session.
wppsender/chrome_profile/

# Manual backup snapshots left in config/data/ during editing - not the
# live config.
config/data/*_backup*.json
config/data/*_apagar*.json

# Credenciais locais temporárias do banco - nunca commitar
credenciais.json
