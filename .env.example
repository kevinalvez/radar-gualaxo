# Copie este arquivo para ".env" e preencha com valores reais.
# ".env" nunca é commitado (ver .gitignore).
#
# As mesmas variáveis precisam ser configuradas separadamente em cada
# lugar que roda o projeto:
#   - Streamlit Community Cloud: painel do app -> Settings -> Secrets
#     (formato TOML: chave = "valor", uma por linha)
#   - GitHub Actions: Settings do repositório -> Secrets and variables
#     -> Actions -> New repository secret

# Postgres (Railway, ou qualquer outro Postgres gerenciado)
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Green API (https://green-api.com) - plano Developer gratuito
# idInstance e apiTokenInstance vêm do console da Green API depois de
# criar a instância; GREEN_API_CHAT_ID é o grupo/contato de destino
# (grupo: "120363041234567890@g.us", contato: "5531999999999@c.us").
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=
